# Copiar a .env. El .env NO se versiona (.gitignore).
#
# Si no existe, levantar.sh genera uno con una contraseña aleatoria y te la
# muestra una vez. Esa contraseña va por Discord a las casas que tengan una
# réplica, y a ningún archivo del repositorio.

REDIS_PASS=cambiame-por-una-contraseña-larga

# Opcionales, sólo si hay que forzarlos:
#
# IP_TAILSCALE=100.101.15.93   # por defecto lo resuelve `tailscale ip -4`
# PUERTO=6379
# DIR_DATOS=~/sdypp/redis-datos
